# Vercel에 배포할 때 운영 API 도메인을 지정합니다.
# 비워두면 vite.config.ts의 dev 프록시(/api → localhost:3000)를 사용합니다.
VITE_API_BASE_URL=

# J-WIN API (@jsure/jwin-api, Railway) 도메인.
# 비워두면 dev 프록시(/jwin-api → localhost:8080)를 사용합니다.
# 로그인은 위 대시보드 API로만 하고, 이 토큰을 그대로 J-WIN API에 보냅니다 (D-10).
VITE_JWIN_API_BASE_URL=

# 빌더 API. 비워두면 VITE_API_BASE_URL(대시보드 API)을 그대로 씁니다.
# 나중에 빌더 서버를 분리하면 이 변수에 그 도메인을 넣습니다.
VITE_BUILDER_API_BASE_URL=

# Sentry — 비우면 초기화 자체를 건너뜁니다.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Sentry source map 업로드 (빌드 타임).
# Vercel Sentry Integration이 운영 환경에 자동 주입합니다. 로컬 빌드에선 비워둡니다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
