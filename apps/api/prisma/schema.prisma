generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String?
  role         AdminUserRole   @default(GUEST)
  status       AdminUserStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  testLineUserId String?

  sessions             AdminUserSession[]
  notices              Notice[]
  lineMessageTemplates LineMessageTemplate[]

  @@map("admin_users")
}

model AdminUserSession {
  id               String    @id @default(cuid())
  adminUserId      String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_user_sessions")
}

enum AdminUserRole {
  GUEST
  ADMIN
  OWNER
}

enum AdminUserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CampaignSubType {
  INSTAGRAM
  TIKTOK
  X
  YOUTUBE
  QOO10
  LIPS
  ATCOSME
}

/// 응모하지 않은 채 자발적으로 함께 공유한 플랫폼. OTHER 는 사용자가 이름을 직접 적는다.
enum CrossPostPlatform {
  LIPS
  ATCOSME
  TIKTOK
  YOUTUBE
  X
  OTHER
}

/// 주소·계좌의 국가. 활성 값은 항상 하나이며 주소와 계좌는 서로 독립이다.
enum AddressCountry {
  JP
  KR
}

enum InfluencerStatus {
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  APPLIED
  REJECTED
  APPROVED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  ORDER_SUBMITTED
  REVIEW_SUBMITTED
}

enum PostReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// 보수 체계.
// - UNIFIED: 참여 서브타입 수와 무관하게 Campaign.rewardJpy 고정 지급.
// - PER_SUBTYPE: 참여한 서브타입별 CampaignRecruit.rewardJpy 합산 지급.
enum RewardType {
  UNIFIED
  PER_SUBTYPE
}

/// 캠페인 발행 상태. DRAFT 는 어드민 임시저장으로, 인플루언서에게 노출되지 않는다.
enum CampaignPublishState {
  DRAFT
  PUBLISHED
}

model Campaign {
  id                 String           @id @default(cuid())
  category           CampaignCategory @default(SNS)
  title              String
  publishState       CampaignPublishState @default(PUBLISHED)
  rewardType         RewardType       @default(UNIFIED)
  /// UNIFIED 캠페인의 보수 금액. PER_SUBTYPE 캠페인에서는 사용하지 않는다.
  rewardJpy          Int
  recruitStartAt     DateTime
  recruitEndAt       DateTime
  closedAt           DateTime?
  /// 비공개 전환 시각. 인플루언서 조회에서만 제외되고 어드민에는 계속 보인다.
  hiddenAt           DateTime?
  /// 논리 삭제 시각. 응모·정산 이력을 보존하기 위해 물리 삭제하지 않는다.
  deletedAt          DateTime?
  postingPeriodDays  Int       @default(14)
  /// 가구매 전용. 승인일로부터 주문 제출까지 허용 일수. null 이면 주문 마감이 없어
  /// 리마인더도 자동 취소도 동작하지 않는다.
  orderPeriodDays    Int?
  productSummary     String
  productDetailUrls  String[]
  guideline          String
  referenceMediaUrls String[]
  cautions           String
  thumbnailUrl       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  recruits     CampaignRecruit[]
  applications CampaignApplication[]
  influencerMemos InfluencerMemo[]

  // 이 캠페인이 "제외 대상" 으로 지정한 다른 캠페인들 (E → A,B)
  exclusionsAsExcluding CampaignExclusion[] @relation("excludingCampaign")
  // 이 캠페인이 다른 캠페인에 의해 "제외 대상" 으로 지정된 관계 (역방향)
  exclusionsAsExcluded  CampaignExclusion[] @relation("excludedCampaign")

  @@index([recruitStartAt])
  @@map("campaigns")
}

// 캠페인 응모 시 제외(exclusion) 관계.
// campaignId 가 신규/현재 캠페인 (E), excludedCampaignId 가 응모 이력이 있으면
// 이 캠페인 응모를 막을 기준 캠페인 (A,B).
model CampaignExclusion {
  id                 String   @id @default(cuid())
  campaignId         String
  excludedCampaignId String
  createdAt          DateTime @default(now())

  campaign         Campaign @relation("excludingCampaign", fields: [campaignId], references: [id], onDelete: Cascade)
  excludedCampaign Campaign @relation("excludedCampaign", fields: [excludedCampaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, excludedCampaignId])
  @@index([excludedCampaignId])
  @@map("campaign_exclusions")
}

model CampaignRecruit {
  id                 String              @id @default(cuid())
  campaignId         String
  subType            CampaignSubType
  minFollowers       Int                 @default(0)
  recruitCount       Int
  /// PER_SUBTYPE 캠페인용: 이 서브타입 참여 보수(JPY). UNIFIED 캠페인은 null.
  rewardJpy          Int?
  subTypeOptions     String[]            @default([])
  insightRequired    Boolean             @default(true)
  isRequired         Boolean             @default(false)
  productPriceJpy    Int?
  productUrl         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  options  CampaignRecruitOption[]

  @@unique([campaignId, subType])
  @@map("campaign_recruits")
}

/// recruit가 모집하는 옵션(FEED/REELS 등)의 세부 설정. 속성별 all-or-nothing:
/// 모든 행에 recruitCount 존재 = 정원 분리(부모 recruitCount = 합계),
/// 모든 행에 rewardJpy 존재 = 보수 분리(부모 rewardJpy = null 강제).
model CampaignRecruitOption {
  id           String @id @default(cuid())
  recruitId    String
  /// subTypeOptions 값 축: "FEED" | "REELS" | (미래: "LIPS" | "ATCOSME")
  option       String
  recruitCount Int?
  rewardJpy    Int?

  recruit CampaignRecruit @relation(fields: [recruitId], references: [id], onDelete: Cascade)

  @@unique([recruitId, option])
  @@map("campaign_recruit_options")
}

model Influencer {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String?
  lineUserId    String?              @unique
  lineLinkedAt  DateTime?
  name          String
  nameKana      String?
  phone         String
  birthDate     DateTime?
  /// 주소 형식의 국가. JP 는 7자리 우편번호+도도부현, KR 은 5자리 우편번호+시/도.
  addressCountry AddressCountry      @default(JP)
  postalCode    String               @default("")
  /// JP: 都道府県 / KR: 시·도
  prefecture    String               @default("")
  /// JP: 市区町村 / KR: 시·군·구
  city          String               @default("")
  /// JP: 番地 / KR: 도로명 주소
  addressLine1  String               @default("")
  /// JP: 建物名・部屋番号 / KR: 상세 주소
  addressLine2  String               @default("")
  memo          String?
  status        InfluencerStatus     @default(ACTIVE)
  flaggedAt     DateTime?
  flaggedById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  snsAccounts  InfluencerSnsAccount[]
  applications CampaignApplication[]
  consents     InfluencerConsent[]
  bankAccount  InfluencerBankAccount?
  sessions     InfluencerSession[]
  memos        InfluencerMemo[]

  @@map("influencers")
}

model InfluencerMemo {
  id           String   @id @default(cuid())
  influencerId String
  campaignId   String?
  comment      String
  createdAt    DateTime @default(now())
  createdById  String?

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([influencerId])
  @@map("influencer_memos")
}

model InfluencerSession {
  id               String    @id @default(cuid())
  influencerId     String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@map("influencer_sessions")
}

model InfluencerSnsAccount {
  id            String   @id @default(cuid())
  influencerId  String
  snsType       CampaignSubType
  handle        String
  followerCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([influencerId, snsType])
  @@map("influencer_sns_accounts")
}

model InfluencerConsent {
  id           String   @id @default(cuid())
  influencerId String
  termsVersion String
  agreedItems  String[]
  agreedAt     DateTime @default(now())
  ip           String?
  userAgent    String?

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, termsVersion])
  @@map("influencer_consents")
}

model InfluencerBankAccount {
  id                String               @id @default(cuid())
  influencerId      String               @unique
  /// 계좌 형식의 국가. 주소 국가와 무관하게 따로 고른다.
  bankCountry       AddressCountry       @default(JP)
  /// JP: 4자리 금융기관 코드 / KR: 3자리 표준 금융기관 코드
  bankCode          String
  bankName          String
  /// 한국 계좌는 지점이 이체에 무관하므로 빈 문자열.
  branchName        String
  branchCode        String               @default("")
  accountNumber     String
  /// 예금주명. JP 는 カナ 표기, KR 은 한글.
  accountHolder String
  /// 適格請求書登録番号 (인보이스 등록번호). T + 13자리 숫자, 선택 입력.
  invoiceRegistrationNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@map("influencer_bank_accounts")
}

model CampaignApplication {
  id           String            @id @default(cuid())
  campaignId   String
  influencerId String
  /// 이 응모가 참여하는 서브타입 목록.
  subTypes     CampaignSubType[]
  status       ApplicationStatus @default(APPLIED)

  appliedAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  rejectReason String?

  trackingCarrier String?
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt    DateTime?
  receivedAt     DateTime?
  completedAt    DateTime?

  orderNumber        String?
  orderSubmittedAt   DateTime?
  /// 제출물(게시물/리뷰) 최종 제출 시각 — 전 카테고리 공통.
  reviewSubmittedAt  DateTime?

  /// 제출물(전체) 검토 상태 — 응모 단위 전체 승인/반려.
  submissionReviewStatus PostReviewStatus @default(PENDING)
  submissionReviewedAt   DateTime?
  submissionReviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer Influencer      @relation(fields: [influencerId], references: [id], onDelete: Restrict)
  posts      SubmittedPost[]
  crossPosts CrossPost[]
  attachments Attachment[]
  lineDispatchLogs LineDispatchLog[]
  submissionRejections SubmissionRejection[]
  settlement Settlement?
  options    CampaignApplicationOption[]

  @@unique([campaignId, influencerId])
  @@index([campaignId, status])
  @@index([influencerId, status])
  @@map("campaign_applications")
}

/// 응모가 선택한 서브타입 옵션 (구 instagramPostType 의 일반화).
/// 현재는 INSTAGRAM 의 FEED/REELS 단일 선택만 사용하지만, 서브타입·복수 선택으로
/// 확장 가능한 구조.
model CampaignApplicationOption {
  id            String          @id @default(cuid())
  applicationId String
  subType       CampaignSubType
  option        String

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, subType, option])
  @@map("campaign_application_options")
}

// 서브타입별 제출 데이터(게시물 URL, 인사이트 지표). 검토/정산은 응모 단위로 진행된다.
model SubmittedPost {
  id                  String    @id @default(cuid())
  applicationId       String
  subType             CampaignSubType
  url                 String?
  submissionData      Json?
  submittedAt         DateTime  @default(now())
  insightLikes        Int?
  insightComments     Int?
  insightShares       Int?
  insightReposts      Int?
  insightSaves        Int?
  insightViews        Int?
  insightReach        Int?
  insightProfileViews Int?
  insightSubmittedAt  DateTime?
  updatedAt           DateTime  @updatedAt

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([applicationId, subType])
  @@index([applicationId])
  @@map("submitted_posts")
}

/// 응모 시 선택하지 않은 플랫폼에 자발적으로 함께 공유한 기록.
/// 보수·검토와 무관하며, 다음 캠페인 선정 시 우대 판단 자료로만 쓴다.
model CrossPost {
  id            String            @id @default(cuid())
  applicationId String
  platform      CrossPostPlatform
  /// OTHER 일 때만 사용하는 사용자 입력 플랫폼명.
  platformName  String?
  url           String
  submittedAt   DateTime          @default(now())

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("cross_posts")
}

enum SettlementStatus {
  PENDING
  COMPLETED
}

model Settlement {
  id            String           @id @default(cuid())
  applicationId String           @unique
  amountJpy     Int
  rewardAmountJpy   Int              @default(0)
  productRefundJpy  Int              @default(0)
  status        SettlementStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  completedById String?

  /// 정산 생성(대기풀 진입) 시점의 계좌 스냅샷 — 이후 마이페이지 변경과 무관하게 보존.
  /// 스냅샷 도입 전 생성된 정산은 null (조회 시 현재 계좌로 fallback).
  bankCountry       AddressCountry?
  bankCode          String?
  bankName          String?
  branchName        String?
  branchCode        String?
  accountNumber     String?
  accountHolder String?
  invoiceRegistrationNumber String?

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("settlements")
}

model Attachment {
  id            String              @id @default(cuid())
  kind          AttachmentKind
  applicationId String
  postId        String?
  objectKey     String              @unique
  contentType   String
  sizeBytes     Int
  uploadedAt    DateTime            @default(now())

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  post        SubmittedPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([applicationId, kind])
  @@index([postId, kind])
  @@map("attachments")
}

// 응모 단위 제출물 반려 이력.
model SubmissionRejection {
  id            String   @id @default(cuid())
  applicationId String
  comment       String
  rejectedAt    DateTime @default(now())
  rejectedById  String?

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("submitted_post_rejections")
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  contentHtml String
  startAt     DateTime
  endAt       DateTime
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author AdminUser @relation(fields: [authorId], references: [id])

  @@index([startAt])
  @@index([endAt])
  @@map("notices")
}

enum BroadcastJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model BroadcastJob {
  id              String             @id @default(cuid())
  status          BroadcastJobStatus @default(QUEUED)
  total           Int                @default(0)
  sent            Int                @default(0)
  failed          Int                @default(0)
  skipped         Int                @default(0)
  contentHtml     String
  heroImageR2Key  String?
  altText         String?
  errorMessage    String?
  createdById     String
  influencerIds   String[]
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([status, createdAt])
  @@map("broadcast_jobs")
}

enum CampaignCategory {
  SNS
  FAKE_PURCHASE
  SIMPLE_REVIEW
}

enum LineTriggerKey {
  SNS_APPLICATION_APPLIED
  SNS_APPLICATION_APPROVED
  SNS_APPLICATION_REJECTED
  SNS_APPLICATION_SHIPPED
  SNS_APPLICATION_DELIVERED
  SNS_APPLICATION_DELIVERY_REMINDER
  SNS_APPLICATION_RECEIPT_CONFIRMED
  SNS_POST_SUBMITTED
  SNS_POST_DEADLINE_REMINDER
  SNS_POST_OVERDUE_REMINDER
  SNS_POST_APPROVED
  SNS_POST_REJECTED
  SNS_POST_REJECTION_REMINDER
  SNS_INSIGHT_SUBMITTED
  SNS_INSIGHT_REMINDER
  SNS_INSIGHT_OVERDUE_REMINDER
  SNS_SETTLEMENT_COMPLETED
  SNS_CAMPAIGN_COMPLETED
  FAKE_PURCHASE_APPLICATION_APPLIED
  FAKE_PURCHASE_APPLICATION_APPROVED
  FAKE_PURCHASE_APPLICATION_REJECTED
  FAKE_PURCHASE_ORDER_DEADLINE_REMINDER
  FAKE_PURCHASE_ORDER_EXPIRED
  FAKE_PURCHASE_ORDER_SUBMITTED
  FAKE_PURCHASE_REVIEW_SUBMITTED
  FAKE_PURCHASE_REVIEW_APPROVED
  FAKE_PURCHASE_REVIEW_REJECTED
  FAKE_PURCHASE_REVIEW_DEADLINE_REMINDER
  FAKE_PURCHASE_REVIEW_OVERDUE_REMINDER
  FAKE_PURCHASE_SETTLEMENT_COMPLETED
  FAKE_PURCHASE_CAMPAIGN_COMPLETED
  SIMPLE_REVIEW_APPLICATION_APPLIED
  SIMPLE_REVIEW_APPLICATION_APPROVED
  SIMPLE_REVIEW_APPLICATION_REJECTED
  SIMPLE_REVIEW_APPLICATION_SHIPPED
  SIMPLE_REVIEW_APPLICATION_DELIVERED
  SIMPLE_REVIEW_APPLICATION_DELIVERY_REMINDER
  SIMPLE_REVIEW_APPLICATION_RECEIPT_CONFIRMED
  SIMPLE_REVIEW_SUBMITTED
  SIMPLE_REVIEW_APPROVED
  SIMPLE_REVIEW_REJECTED
  SIMPLE_REVIEW_DEADLINE_REMINDER
  SIMPLE_REVIEW_OVERDUE_REMINDER
  SIMPLE_REVIEW_REJECTION_REMINDER
  SIMPLE_REVIEW_SETTLEMENT_COMPLETED
  SIMPLE_REVIEW_CAMPAIGN_COMPLETED
}

enum AttachmentKind {
  INSIGHT_SCREENSHOT
  ORDER_RECEIPT
  REVIEW_SCREENSHOT
}

enum LineTriggerSubType {
  INSTAGRAM
  X
  QOO10
}

enum LineDispatchStatus {
  SUCCESS
  FAILED
  SKIPPED_DISABLED
  SKIPPED_NO_TEMPLATE
}

model LineMessageTemplate {
  id          String           @id @default(cuid())
  category    CampaignCategory
  triggerKey  LineTriggerKey
  enabled     Boolean          @default(false)
  body        String
  updatedAt   DateTime         @updatedAt
  updatedById String?

  updatedBy    AdminUser?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  dispatchLogs LineDispatchLog[]

  @@unique([category, triggerKey])
  @@map("line_message_templates")
}

model LineDispatchLog {
  id            String                 @id @default(cuid())
  category      CampaignCategory
  subType       LineTriggerSubType?
  triggerKey    LineTriggerKey
  templateId    String?
  template      LineMessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  applicationId String?
  application   CampaignApplication?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  toLineUserId  String
  renderedBody  String
  status        LineDispatchStatus
  errorMessage  String?
  createdAt     DateTime               @default(now())

  @@index([applicationId, triggerKey])
  @@index([createdAt])
  @@map("line_dispatch_logs")
}

enum AdminActivityOrigin {
  ADMIN
  CASCADE
  SYSTEM
}

/// 어드민 도메인 액션의 append-only 감사 로그. 상태 컬럼(reviewedById 등)은
/// "현재 값", 이 테이블은 "누가 언제 무엇을 했는지"의 이력을 담당한다.
model AdminActivityLog {
  id     String              @id @default(cuid())
  /// AdminActivityAction (packages/shared zod enum) 값. Prisma enum 이 아닌
  /// String 인 이유: 액션 종류는 계속 늘어나는데 PostgreSQL enum 은 값 제거가
  /// 불가능해 마이그레이션 부채가 쌓인다. 유효성은 AuditService 시그니처
  /// (z.infer 유니온 타입)가 컴파일 타임에 보장한다.
  action String
  origin AdminActivityOrigin @default(ADMIN)

  /// 수행 어드민. SYSTEM 이면 null.
  actorId   String?
  /// 행위 시점의 어드민 이름 스냅샷 — 계정 삭제/개명 후에도 감사 기록 보존.
  actorName String?

  /// 대상 참조. FK 를 걸지 않는다 — 감사 로그는 도메인 row 의 삭제를 막아서도,
  /// 삭제에 딸려 지워져서도 안 된다. 참조는 "그 시점의 사실"이고, 사람이 읽을
  /// 문맥은 metadata 스냅샷이 담당한다.
  applicationId String?
  campaignId    String?
  settlementId  String?
  influencerId  String?

  /// 액션 부가 정보(사유, 변경 필드명, 유발 이벤트 등). PII(계좌번호·주소 등)
  /// 는 넣지 않는다.
  metadata Json?

  createdAt DateTime @default(now())

  /// 1차는 실제로 쿼리되는 2개만. campaignId/influencerId/actorId 인덱스는
  /// 해당 조회 API 를 붙이는 후속 작업에서 additive 로 추가한다.
  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("admin_activity_logs")
}
