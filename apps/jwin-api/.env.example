# apps/jwin-api/.env 의 템플릿. 복사해서 값을 채운다.
#   cp apps/jwin-api/.env.example apps/jwin-api/.env
#
# Prisma CLI 는 이 파일을 읽지 않는다. 마이그레이션을 돌리려면
# packages/jwin-db/.env 에 DATABASE_URL / DIRECT_DATABASE_URL 을 같은 값으로 한 벌 더 둔다.
# 웹은 apps/jwin-web/.env.local 의 NEXT_PUBLIC_API_BASE_URL 을 쓴다.

# ── 공통 ─────────────────────────────────────────────
NODE_ENV=development

# ── Neon Postgres (J-WIN 전용 DB) ────────────────────
# 기존 대시보드 DB와 반드시 분리할 것 — 섞으면 migrate 시 리셋 위험
# pooled connection (런타임용)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# direct connection (마이그레이션용, Neon: non-pooled)
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── API 서버 (Railway) ───────────────────────────────
PORT=8080
API_BASE_URL=http://localhost:8080
# jwin-web 은 next dev --port 3100 으로 뜬다 (기존 앱들과 포트 충돌 회피)
WEB_BASE_URL=http://localhost:3100
# CORS 허용 origin 목록 (쉼표 구분). 대시보드 @jsure/api 의 CORS_ORIGIN 과 같은 이름·형식.
# WEB_BASE_URL 은 항상 허용되므로 어드민 UI origin 만 넣으면 된다. 로컬 vite dev 서버는 5173
CORS_ORIGIN=http://localhost:5173
# 응모자 세션 쿠키 서명 키 (openssl rand -hex 32)
SESSION_SECRET=change-me
# X 토큰 저장용 AES-256-GCM 키 (openssl rand -hex 32, 64자 hex 고정)
# 교체 시 저장된 토큰을 복호화할 수 없어 전 계정 재연동 필요
TOKEN_ENCRYPTION_KEY=change-me

# ── X API (developer console 종량제 앱) ──────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
# 브랜드 연동 콜백: {API_BASE_URL}/oauth/brand/callback
# 유저 로그인 콜백: {API_BASE_URL}/oauth/user/callback

# ── 어드민 인증 (D-10) ───────────────────────────────
# J-WIN에는 어드민 계정도 로그인 엔드포인트도 없다. 운영자는 대시보드(@jsure/admin-web)에서
# 로그인하고, 그때 받은 access token을 Authorization: Bearer 로 jwin-api에 보낸다.
# 따라서 이 값은 apps/api 의 JWT_SECRET 과 반드시 같아야 한다 (다르면 어드민 API 전부 401).
JWT_SECRET=change-me

# ── 스케줄러 ─────────────────────────────────────────
# 인프로세스 크론 on/off (주기는 코드 고정). 로컬에서는 false 권장 — 실제 X 게시 방지
SCHEDULER_ENABLED=true

# TZ 는 설정하지 않는다 (= UTC).
# scheduler.ts 의 '5 15 * * *' 가 "UTC 15:05 = JST 00:05" 전제이고 node-cron 은
# timezone 옵션이 없으면 프로세스 로컬 시각을 쓰므로, TZ=Asia/Tokyo 를 켜면
# 당일분 생성 잡이 15시간 어긋난다. dateJst()/jstToUtc() 는 TZ 와 무관하다.
