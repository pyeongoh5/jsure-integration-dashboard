# ── 공통 ─────────────────────────────────────────────
NODE_ENV=development

# Neon Postgres (pooled connection string 사용)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/jwin?sslmode=require
# 마이그레이션용 direct connection (Neon: non-pooled)
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/jwin?sslmode=require

# ── API 서버 (Railway) ───────────────────────────────
PORT=8080
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
# 세션/JWT 서명 키 (openssl rand -hex 32)
SESSION_SECRET=change-me
# X 토큰 저장용 AES-256-GCM 키 (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=change-me

# ── X API (developer console 종량제 앱) ──────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
# 브랜드 연동 콜백: {API_BASE_URL}/oauth/brand/callback
# 유저 로그인 콜백: {API_BASE_URL}/oauth/user/callback

# ── 어드민 ───────────────────────────────────────────
ADMIN_EMAIL=admin@j-sure.example
# bcrypt hash (스크립트: apps/api/scripts/hash-password.ts)
ADMIN_PASSWORD_HASH=

# ── 스케줄러 ─────────────────────────────────────────
# 매일 포스팅 체크 주기(분 단위 cron은 코드에 고정, 비활성화 스위치만 제공)
SCHEDULER_ENABLED=true
TZ=Asia/Tokyo
