# apps/jwin-web/.env.local 의 템플릿. 복사해서 값을 채운다.
#   cp apps/jwin-web/.env.example apps/jwin-web/.env.local
#
# 참여자용 공개 웹(Next.js). 운영은 Vercel 새 프로젝트, Root Directory = apps/jwin-web

# jwin-api(Railway) 의 공개 주소. 브라우저에서 직접 호출하므로 NEXT_PUBLIC_ 접두사가 필요하다.
# 비워두면 http://localhost:8080 을 쓴다 (로컬 jwin-api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
